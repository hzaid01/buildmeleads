{
  "name": "local-business-lead-generator",
  "version": "1.0.0",
  "description": "Local business lead-generation tool with gosom self-hosted scraper, Apify fallback, WhatsApp verification, and CSV export",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run_tests.js",
    "test:node": "node tests/test_services.js",
    "engine": "python -m uvicorn lead_engine.app:app --host 127.0.0.1 --port 8000",
    "import:leads": "python -m lead_engine.cli import"
  },
  "keywords": [
    "lead-generation",
    "google-maps-scraper",
    "gosom",
    "apify",
    "whatsapp-verification"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "apify-client": "^2.11.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-libphonenumber": "^3.2.40"
  },
  "devDependencies": {}
}
