# =====================================================================
# BuildMeLeads / Lead Scout — Environment Configuration
# =====================================================================
# Copy this file to .env and configure the variables below.
# NEVER commit your real .env file to version control.

# Server & Networking
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000

# Apify API Token (Optional fallback for Google Maps scraping & WhatsApp verification)
# Get your token from: https://console.apify.com/account/integrations
APIFY_TOKEN=

# Self-Hosted gosom Google Maps Scraper (Docker)
GOSOM_API_URL=http://localhost:8080
DOCKER_IMAGE=gosom/google-maps-scraper
DOCKER_CONTAINER_NAME=gosom-scraper

# Python Lead Engine Service
LEAD_ENGINE_URL=http://127.0.0.1:8000
LEAD_ENGINE_HOST=127.0.0.1
LEAD_ENGINE_PORT=8000
LEAD_ENGINE_TOKEN=replace_with_a_long_random_secret_token
LEAD_DB_PATH=data/leads.db
LEAD_ENGINE_MANAGE_PID_FILE=true

# Session & Security Settings
# In production with HTTPS, remove SESSION_COOKIE_SECURE=false
SESSION_HOURS=168
SESSION_COOKIE_SECURE=false

# Lead Enrichment Settings
ENABLE_PLAYWRIGHT_ENRICHMENT=false
WEBSITE_TIMEOUT_SECONDS=12

# Campaign Default Parameters
CAMPAIGN_NAME=free-gbp-audit
CAMPAIGN_OFFER=a free Google Business Profile audit
CAMPAIGN_CTA=Ask if they are the right person to share it with
CAMPAIGN_START_DATE=
OUTREACH_HOME_TIMEZONE=America/New_York
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=17
MIN_SEND_DELAY_MINUTES=15
MAX_SEND_DELAY_MINUTES=45

# Sender Identity & Compliance Settings
SENDER_NAME=[YOUR NAME]
BUSINESS_NAME=[YOUR AGENCY NAME]
SENDER_EMAIL=
REPLY_TO_EMAIL=[YOUR EMAIL YOU CHECK DAILY]
PHYSICAL_ADDRESS=[YOUR VALID PHYSICAL POSTAL ADDRESS]
BUSINESS_WEBSITE=

# SendGrid Outreach Provider (Optional if using Gmail OAuth)
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_VERIFICATION_KEY=
SENDGRID_WEBHOOK_TOKEN=replace_with_a_random_webhook_token

# Groq AI Personalization Model
# Supported: openai/gpt-oss-120b (Quality) or openai/gpt-oss-20b (Speed)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gmail OAuth Provider (gmail.send scope)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/gmail/oauth/callback
GMAIL_TESTING_MODE=true
GMAIL_TEST_USER_LIMIT=100
# Generate a Fernet encryption key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional Landing Page Waitlist SMTP Notifications
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# Optional Payment Gateway Providers (Paddle / NOWPayments)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
