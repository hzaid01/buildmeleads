# Lead Generation Tool Environment Variables

# Server Port
PORT=3000
HOST=127.0.0.1

# Apify API Token (Required for fallback Google Maps scraping and WhatsApp verification)
# Get your token from https://console.apify.com/account/integrations
APIFY_TOKEN=

# Self-Hosted gosom Google Maps Scraper Settings
# Default URL if running gosom Web/API mode via Docker Compose
GOSOM_API_URL=http://localhost:8080

# Docker Settings (if invoking CLI directly)
DOCKER_IMAGE=gosom/google-maps-scraper
DOCKER_CONTAINER_NAME=gosom-scraper

# Separate Python lead engine (keep both services on loopback)
LEAD_ENGINE_URL=http://127.0.0.1:8000
LEAD_ENGINE_HOST=127.0.0.1
LEAD_ENGINE_PORT=8000
LEAD_ENGINE_TOKEN=replace_with_a_long_random_local_service_token
LEAD_DB_PATH=data/leads.db
# Keep enabled outside isolated tests; prevents two engine instances sharing a DB.
LEAD_ENGINE_MANAGE_PID_FILE=true

# Website enrichment. BeautifulSoup is primary; Playwright is an optional JS fallback.
ENABLE_PLAYWRIGHT_ENRICHMENT=false
WEBSITE_TIMEOUT_SECONDS=12

# Outreach remains hard-locked until both flags are deliberately changed.
OUTREACH_DRY_RUN=true
LIVE_SENDING_ENABLED=false
CAMPAIGN_NAME=free-gbp-audit
CAMPAIGN_START_DATE=
OUTREACH_HOME_TIMEZONE=America/New_York
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=17
MIN_SEND_DELAY_MINUTES=15
MAX_SEND_DELAY_MINUTES=45

# SendGrid and CAN-SPAM identity (replace every placeholder before live use)
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_VERIFICATION_KEY=
SENDGRID_WEBHOOK_TOKEN=replace_with_a_long_random_webhook_token
SENDER_NAME=[YOUR NAME]
BUSINESS_NAME=[YOUR AGENCY NAME]
SENDER_EMAIL=
REPLY_TO_EMAIL=[YOUR EMAIL YOU CHECK DAILY]
PHYSICAL_ADDRESS=[YOUR VALID LAHORE POSTAL ADDRESS]
BUSINESS_WEBSITE=
PUBLIC_BASE_URL=http://127.0.0.1:3000
